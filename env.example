# Juniper Mist API Configuration
# Get these values from your Mist dashboard

# Your Mist Site ID (found in Mist dashboard under Sites)
MISTSITEID=your_site_id_here

# Your WLAN ID (found in Mist dashboard under WLANs)
WLANID=your_wlan_id_here

# Your Mist API Token (generate in Mist dashboard under Organization > Settings > API Tokens)
MISTTOKEN=your_api_token_here

# Optional: MongoDB connection string (if you're using MongoDB)
MONGODB_URI=your_mongodb_connection_string_here 